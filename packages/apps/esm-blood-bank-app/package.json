{
  "name": "@sihsalus/esm-blood-bank-app",
  "version": "1.0.0-alpha",
  "license": "MPL-2.0",
  "description": "SIH Salus blood bank prototype microfrontend",
  "browser": "dist/sihsalus-esm-blood-bank-app.js",
  "main": "src/index.ts",
  "source": true,
  "scripts": {
    "start": "openmrs develop",
    "serve": "rspack serve --mode=development",
    "standalone": "rspack serve --config rspack.standalone.config.js --mode=development",
    "build:standalone": "rspack --config rspack.standalone.config.js --mode=production",
    "build": "rspack --mode=production",
    "lint": "node ../../tooling/scripts/run-biome.js lint .",
    "typescript": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "coverage": "vitest run --coverage",
    "extract-translations": "i18next 'src/**/*.{ts,tsx}' '!src/**/*.test.{ts,tsx}' '!src/**/*.spec.{ts,tsx}' --config ../../tooling/scripts/i18next-parser.config.js"
  },
  "files": [
    "dist",
    "src",
    "translations"
  ],
  "browserslist": [
    "extends browserslist-config-openmrs"
  ],
  "keywords": [
    "openmrs",
    "sihsalus",
    "blood-bank"
  ],
  "dependencies": {
    "@carbon/react": "^1.92.1",
    "@sihsalus/esm-rbac": "workspace:*"
  },
  "peerDependencies": {
    "@openmrs/esm-framework": "*",
    "react": "18.x",
    "react-i18next": "16.x",
    "react-router-dom": ">=6.30.4 <8",
    "rxjs": "6.x"
  },
  "devDependencies": {
    "@carbon/styles": "1.102.0",
    "@openmrs/esm-framework": "workspace:*",
    "@rspack/cli": "1.7.11",
    "@rspack/core": "1.7.11",
    "@swc/core": "1.15.21",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.21",
    "@types/react-dom": "^18.3.0",
    "css-loader": "6.11.0",
    "i18next": "^26.3.6",
    "openmrs": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.0.0",
    "react-router-dom": "7.18.2",
    "rxjs": "^6.6.7",
    "sass-embedded": "1.89.0",
    "sass-loader": "16.0.5",
    "style-loader": "4.0.0",
    "swc-loader": "0.2.7",
    "typescript": "6.0.3",
    "vitest": "^4.1.7"
  }
}
